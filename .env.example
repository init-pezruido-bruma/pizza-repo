# URL canónica del sitio (sitemap, robots, metadata, OG)
# En Vercel: Project Settings → Environment Variables
#
# Ahora (staging):  https://incrediblepizza.init.com.mx
# Después (prod):   https://incrediblepizza.mx
#
# Si no la defines (o la dejas vacía), se usa el staging.
NEXT_PUBLIC_SITE_URL=https://incrediblepizza.init.com.mx

# --- Backend / Auth ---
# Local (Docker): npm run db:up
DATABASE_URL="postgresql://pizza:pizza@localhost:5433/pizza"
DIRECT_URL="postgresql://pizza:pizza@localhost:5433/pizza"
# En Vercel: Storage → Neon. Usa la URL con pooling en DATABASE_URL
# y la URL "direct" / non-pooling en DIRECT_URL.
AUTH_SECRET="generate-a-long-random-secret"
# Mantén el puerto alineado con npm run dev (3000)
AUTH_URL="http://localhost:3000"

# Primer admin (npm run db:seed)
ADMIN_EMAIL=admin@incrediblepizza.mx
ADMIN_PASSWORD=cambia-esto
ADMIN_NAME=Admin

# Correo (opcional). Sin RESEND_API_KEY las cotizaciones se guardan igual.
# RESEND_API_KEY=
MAIL_FROM=noreply@incrediblepizza.mx

# Promos en Vercel: Storage → Blob. En local se guardan en public/uploads/.
# BLOB_READ_WRITE_TOKEN=
